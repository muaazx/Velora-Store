{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/.prisma/**"
    }
  },
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
